# Let the node reach a handset without root.
#
# Matching on the adb interface class rather than a vendor id, because the
# owner will one day replace the phone and no one is editing udev rules in a
# marina office.
SUBSYSTEM=="usb", ATTR{bInterfaceClass}=="ff", ATTR{bInterfaceSubClass}=="42", ATTR{bInterfaceProtocol}=="01", MODE="0660", GROUP="plugdev", TAG+="uaccess"
